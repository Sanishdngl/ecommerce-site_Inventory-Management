{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "gateway",
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace=gateway",
    "dev:admin": "npm run dev --workspace=services/admin-service",
    "dev:inventory": "npm run dev --workspace=services/inventory-service",
    "dev:customer": "npm run dev --workspace=services/customer-service",
    "build": "npm run build --workspaces",
    "start:gateway": "npm start --workspace=gateway",
    "start:admin": "npm start --workspace=services/admin-service",
    "start:customer": "npm start --workspace=services/customer-service",
    "start:inventory": "npm start --workspace=services/inventory-service",
    "test:unit": "jest --testPathPattern=tests/unit --runInBand",
    "test:integration": "jest --testPathPattern=tests/integration --runInBand",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "migrate:latest": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "migrate:status": "knex --knexfile knexfile.ts migrate:status",
    "seed:run": "knex --knexfile knexfile.ts seed:run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "mysql2": "^3.22.4",
    "uuid": "^14.0.0"
  }
}
