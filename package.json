{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "gateway",
    "services/*"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace=gateway",
    "dev:admin": "npm run dev --workspace=services/admin-service",
    "dev:inventory": "npm run dev --workspace=services/inventory-service",
    "dev:customer": "npm run dev --workspace=services/customer-service",
    "build": "npm run build --workspaces",
    "start:gateway": "npm start --workspace=gateway",
    "start:admin": "npm start --workspace=services/admin-service",
    "start:customer": "npm start --workspace=services/customer-service",
    "start:inventory": "npm start --workspace=services/inventory-service",
    "test:unit": "jest --testPathPatterns=tests/unit --runInBand --forceExit",
    "test:integration": "jest --testPathPatterns=tests/integration --runInBand --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "migrate:latest": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "migrate:status": "knex --knexfile knexfile.ts migrate:status",
    "seed:run": "knex --knexfile knexfile.ts seed:run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "kafkajs": "^2.2.4",
    "knex": "^3.2.10",
    "mysql2": "^3.22.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
