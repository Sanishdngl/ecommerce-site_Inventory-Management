{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "rootDir": "..",
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@shared/*": ["../shared/src/*"],
      "@infrastructure/*": ["../infrastructure/*"]
    }
  },
  "include": [
    "**/*.test.ts",
    "../shared/src/**/*",
    "../gateway/src/**/*",
    "../services/*/src/**/*"
  ]
}
